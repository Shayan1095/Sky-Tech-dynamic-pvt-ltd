# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Any alternate build directory. Tailwind v4 discovers its sources by
# walking the project and honouring .gitignore, so a build folder left
# unignored gets scanned and its binary chunks become garbage utilities.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - real values never leave the machine they are set on.
.env*
# .env.example is the template: variable names only, no values.
!.env.example

# vercel
.vercel

# local editor / assistant tooling
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# SKY Tech Dynamic — server configuration
#
# Copy to .env.local for development. In production these go in
# hPanel > Websites > (site) > Environment Variables, or Vercel's project
# settings. Real values are never committed to this repository.
#
# The site builds and serves with none of these set. The contact form then
# reports that it is unavailable and shows the phone number and email address
# instead, rather than accepting a message it cannot keep.

# --- Database ------------------------------------------------------------
# From hPanel > Databases > Management. The host is localhost when the app
# runs on Hostinger; use the remote host and enable Remote MySQL to connect
# from your own machine.
DATABASE_URL="mysql://user:password@localhost:3306/database"

# --- Notification email --------------------------------------------------
# Hostinger mailboxes: smtp.hostinger.com, port 465 (implicit TLS).
# SMTP_USER and MAIL_FROM must be a mailbox that really exists on the domain,
# or the receiving server rejects the message as a forgery.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@skytech.com.pk"
SMTP_PASSWORD=""
MAIL_FROM="info@skytech.com.pk"
# Where new enquiries are delivered.
MAIL_TO="jnumaira@gmail.com"

# --- Secrets -------------------------------------------------------------
# Salt for hashing visitor IP addresses before they are counted for rate
# limiting. The address itself is never stored. Any long random string;
# changing it resets the counters.
IP_SALT=""

# Shared secret for the cron endpoint that retries unsent notifications
# (/api/tasks/flush-mail). Leave empty to disable that endpoint.
TASK_TOKEN=""

# --- Site ----------------------------------------------------------------
# Absolute URL of the live site, used for canonical links and the share image.
NEXT_PUBLIC_SITE_URL="https://skytech.com.pk"
